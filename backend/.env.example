# Puerto del servidor
PORT=3000

# Clave secreta para sesiones (generar con: openssl rand -hex 32)
SESSION_SECRET=tu_clave_secreta_muy_segura_aqui

# Clave de encriptación para credenciales (32 caracteres para AES-256)
ENCRYPTION_KEY=tu_clave_de_encriptacion_32caracteres

# Configuración de Redis (opcional, para producción)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Duración de sesión en milisegundos (24 horas)
SESSION_MAX_AGE=86400000

# URLs de OAuth2 para Gmail (opcional)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# URLs de OAuth2 para Outlook (opcional)
OUTLOOK_CLIENT_ID=tu_outlook_client_id
OUTLOOK_CLIENT_SECRET=tu_outlook_client_secret
OUTLOOK_REDIRECT_URI=http://localhost:3000/auth/outlook/callback
